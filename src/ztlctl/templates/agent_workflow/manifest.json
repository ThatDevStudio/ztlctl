{
  "shared_modules": {
    "methodology": "shared/methodology.md.jinja",
    "session_lifecycle": "shared/session-lifecycle.md.jinja",
    "capture_workflow": "shared/capture-workflow.md.jinja",
    "review_workflow": "shared/review-workflow.md.jinja",
    "graph_analysis": "shared/graph-analysis.md.jinja",
    "synthesis_agent": "shared/synthesis-agent.md.jinja",
    "vault_analyst": "shared/vault-analyst.md.jinja",
    "hook_orientation": "shared/hook-orientation.md.jinja"
  },
  "clients": {
    "claude": {
      "files": [
        {
          "template": "claude/.mcp.json.jinja",
          "output": ".mcp.json",
          "schema": "mcp_config"
        },
        {
          "template": "claude/.claude/settings.json.jinja",
          "output": ".claude/settings.json",
          "schema": "claude_settings"
        },
        {
          "template": "claude/.claude/hooks/session-context.sh.jinja",
          "output": ".claude/hooks/session-context.sh",
          "executable": true
        },
        {
          "template": "claude/.claude/commands/ztlctl-session.md.jinja",
          "output": ".claude/commands/ztlctl-session.md",
          "resources": ["ztlctl://context"],
          "tools": ["status", "start", "list_items", "work_queue"]
        },
        {
          "template": "claude/.claude/commands/ztlctl-capture.md.jinja",
          "output": ".claude/commands/ztlctl-capture.md",
          "resources": ["ztlctl://capture/spec"],
          "tools": ["search", "list_tags", "list_providers", "ingest_text", "ingest_url", "create_note", "create_reference", "create_task", "reweave"],
          "prompts": ["capture_web_source", "capture_multimodal_source"]
        },
        {
          "template": "claude/.claude/commands/ztlctl-review.md.jinja",
          "output": ".claude/commands/ztlctl-review.md",
          "resources": ["ztlctl://review/dashboard", "ztlctl://garden/backlog"],
          "tools": ["vault_review", "topic_packet", "draft_from_topic"],
          "prompts": ["topic_review"]
        },
        {
          "template": "claude/.claude/commands/ztlctl-seed.md.jinja",
          "output": ".claude/commands/ztlctl-seed.md",
          "tools": ["create_note", "status"]
        },
        {
          "template": "claude/.claude/agents/knowledge-synthesizer.md.jinja",
          "output": ".claude/agents/knowledge-synthesizer.md",
          "tools": ["search", "get", "related", "topic_packet", "draft_from_topic", "themes", "path", "list_items", "create_note", "reweave"],
          "prompts": ["topic_learn", "topic_decision"]
        },
        {
          "template": "claude/.claude/agents/vault-analyst.md.jinja",
          "output": ".claude/agents/vault-analyst.md",
          "resources": ["ztlctl://review/dashboard", "ztlctl://decision-queue"],
          "tools": ["vault_review", "bridges", "decision_support", "work_queue", "topic_packet", "draft_from_topic"],
          "prompts": ["topic_review"]
        },
        {
          "template": "claude/.claude/skills/vault-methodology/SKILL.md.jinja",
          "output": ".claude/skills/vault-methodology/SKILL.md",
          "resources": ["ztlctl://capture/spec"],
          "tools": ["create_note", "create_reference", "create_task", "ingest_text", "ingest_url", "list_providers", "list_tags", "reweave"],
          "prompts": ["capture_web_source", "capture_multimodal_source"]
        },
        {
          "template": "claude/.claude/skills/session-workflow/SKILL.md.jinja",
          "output": ".claude/skills/session-workflow/SKILL.md",
          "tools": ["status", "start", "work_queue", "close", "themes", "gaps", "bridges"]
        },
        {
          "template": "claude/.claude/skills/graph-intelligence/SKILL.md.jinja",
          "output": ".claude/skills/graph-intelligence/SKILL.md",
          "tools": ["themes", "rank", "path", "gaps", "bridges", "related"]
        }
      ]
    },
    "codex": {
      "files": [
        {
          "template": "codex/AGENTS.md.jinja",
          "output": "AGENTS.md",
          "resources": ["ztlctl://review/dashboard", "ztlctl://garden/backlog", "ztlctl://decision-queue", "ztlctl://capture/spec"],
          "tools": ["status", "start", "close", "create_note", "create_reference", "create_task", "ingest_text", "ingest_url", "list_providers", "reweave", "vault_review", "list_tags", "search", "get", "related", "topic_packet", "draft_from_topic", "themes", "rank", "path", "gaps", "bridges", "decision_support", "work_queue"],
          "prompts": ["topic_learn", "topic_review", "topic_decision", "capture_web_source", "capture_multimodal_source"]
        },
        {
          "template": "codex/.ztlctl/codex/skills/methodology.md.jinja",
          "output": ".ztlctl/codex/skills/methodology.md",
          "resources": ["ztlctl://capture/spec"],
          "tools": ["create_note", "create_reference", "create_task", "ingest_text", "ingest_url", "list_providers", "list_tags", "reweave"],
          "prompts": ["capture_web_source", "capture_multimodal_source"]
        },
        {
          "template": "codex/.ztlctl/codex/skills/session-workflow.md.jinja",
          "output": ".ztlctl/codex/skills/session-workflow.md",
          "tools": ["status", "start", "work_queue", "close", "themes", "gaps", "bridges"]
        },
        {
          "template": "codex/.ztlctl/codex/skills/graph-intelligence.md.jinja",
          "output": ".ztlctl/codex/skills/graph-intelligence.md",
          "tools": ["themes", "rank", "path", "gaps", "bridges", "related"]
        }
      ]
    }
  }
}
